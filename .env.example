# ==========================================
# UNFOLD Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Authentication (JWT)
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Local Development Database (Default: SQLite file)
DATABASE_URL="file:./dev.db"

# Production Database (Optional: Hosted SQLite via Turso / libSQL)
# TURSO_DATABASE_URL="libsql://unfold-your-db.turso.io"
# TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Client URL (For CORS when running on different domains)
CLIENT_URL="http://localhost:5173"
